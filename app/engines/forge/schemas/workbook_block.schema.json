{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meshpool:forge/workbook_block",
  "title": "Forge workbook model block",
  "description": "What the content model writes for a workbook. The builder turns it into sheets, styles, named ranges and formulas; the model never writes cell addresses. Carries roles, sources, checks and a dashboard alongside the rows and inputs.",
  "type": "object",
  "required": ["title", "periods", "inputs", "calc", "checks"],
  "additionalProperties": false,
  "$defs": {
    "fmt": {"enum": ["usd", "usd2", "usdk", "usdm", "eur", "gbp", "pct", "int", "num", "x", "days"]},
    "source": {"type": "object", "required": ["doc"], "properties": {"doc": {"type": "string"}, "page": {"type": "integer"},
               "span": {"type": "string"}, "prov": {"type": "string"}}},
    "row": {"type": "object", "required": ["key", "label", "fmt"], "additionalProperties": false,
            "properties": {
              "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "label": {"type": "string", "description": "must name the unit, e.g. 'Revenue ($K)' (X10)"},
              "fmt": {"$ref": "#/$defs/fmt"},
              "formula": {"type": "string", "description": "one pattern for every period, e.g. ={revenue}-{cost}; refs: {row}, {row@prev}, {row@first}, {row@last}, {row@all}, scalar input keys"},
              "first": {"type": "string", "description": "first-period formula when it differs (e.g. links to the last historical); the only allowed exception to X8"},
              "next": {"type": "string", "description": "formula for every later period"},
              "total": {"type": "boolean"},
              "sheet": {"type": "string", "description": "IS, BS, CF or a schedule name"}
            }}
  },
  "properties": {
    "title": {"type": "string"},
    "purpose": {"type": "string"},
    "units_note": {"type": "string"},
    "periods": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(FY)?\\d{2,4}[AEBF]?$"},
                "description": "e.g. ['2023A','2024A','2025E',...]; A = historical (needs a source, X4)"},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["key", "label", "value", "fmt"],
               "properties": {"key": {"type": "string"}, "label": {"type": "string"}, "value": {"type": "number"},
                              "fmt": {"$ref": "#/$defs/fmt"}, "source": {"$ref": "#/$defs/source"},
                              "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2, "description": "sensitivity low/high"}}}},
    "input_series": {"type": "array", "items": {"type": "object", "required": ["key", "label", "values", "fmt"],
                     "properties": {"key": {"type": "string"}, "label": {"type": "string"},
                                    "values": {"type": "array", "items": {"type": ["number", "null"]}},
                                    "fmt": {"$ref": "#/$defs/fmt"},
                                    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}, "description": "one per historical period"}}}},
    "calc": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["label", "formula", "fmt"],
                "properties": {"label": {"type": "string"}, "formula": {"type": "string"}, "fmt": {"$ref": "#/$defs/fmt"}, "kpi": {"type": "boolean"}}}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["label", "diff"],
               "properties": {"label": {"type": "string"}, "diff": {"type": "string", "description": "formula that must equal 0 in every period, e.g. ={assets}-{liabilities}-{equity}"},
                              "kind": {"enum": ["balance", "cash_tie", "historical_tie", "sign", "custom"]}}}},
    "reported": {"type": "array", "description": "reported totals for historical tie-outs (X4)",
                 "items": {"type": "object", "required": ["row", "period", "value", "source"],
                           "properties": {"row": {"type": "string"}, "period": {"type": "string"}, "value": {"type": "number"}, "source": {"$ref": "#/$defs/source"}}}},
    "circularity": {"type": "object", "properties": {"allowed": {"type": "boolean"}, "why": {"type": "string"}},
                    "description": "off by default; when allowed, the builder adds iterative calc and a circuit-breaker input (X6)"},
    "dashboard": {"type": "object", "properties": {
      "message": {"type": "string", "description": "the one message of the page"},
      "kpis": {"type": "array", "maxItems": 6, "items": {"type": "object", "required": ["label", "row", "compare"],
               "properties": {"label": {"type": "string"}, "row": {"type": "string"}, "period": {"type": "string"},
                              "compare": {"enum": ["prior_period", "plan", "first_period"]}}}},
      "charts": {"type": "array", "maxItems": 4, "items": {"type": "object", "required": ["kind", "rows"],
                 "properties": {"kind": {"enum": ["column", "line", "stacked_column", "waterfall", "bar"]},
                                "rows": {"type": "array", "items": {"type": "string"}}, "title": {"type": "string"}}}}}},
    "recompute": {"type": "array", "description": "outputs the builder recomputes in Python from the same inputs (X7)",
                  "items": {"type": "string"}}
  }
}
