{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meshpool:forge/slide",
  "title": "Forge slide content",
  "description": "The only thing the content model writes for a slide. No coordinates, colours, fonts or OOXML: the renderer owns layout. Every number carries a provenance ID.",
  "type": "object",
  "required": ["id", "node", "archetype", "title"],
  "additionalProperties": false,
  "$defs": {
    "prov": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]+(\\.[0-9]+)?$"}, "description": "Provenance IDs from the intake fact sheet, e.g. F12 (fact), T3.4 (table 3 row 4)"},
    "text": {"type": "object", "required": ["text"], "additionalProperties": false,
             "properties": {"text": {"type": "string", "maxLength": 240}, "prov": {"$ref": "#/$defs/prov"},
                            "emphasis": {"type": "boolean"}}},
    "bullet": {"type": "object", "required": ["text"], "additionalProperties": false,
               "properties": {"text": {"type": "string", "maxLength": 160}, "level": {"enum": [0, 1]},
                              "prov": {"$ref": "#/$defs/prov"}, "icon": {"type": "string", "description": "icon meaning, e.g. 'growth'; resolved against the one bundled set"}}},
    "series": {"type": "object", "required": ["name", "values"], "additionalProperties": false,
               "properties": {"name": {"type": "string"}, "values": {"type": "array", "items": {"type": ["number", "null"]}},
                              "prov": {"$ref": "#/$defs/prov"}, "highlight": {"type": "boolean"}}},
    "chart": {"type": "object", "required": ["kind", "categories", "series", "unit"], "additionalProperties": false,
              "properties": {
                "kind": {"enum": ["bar", "column", "stacked_column", "stacked_bar", "pct_stacked_column", "line", "combo",
                                  "waterfall", "marimekko", "scatter", "bubble", "gantt", "harvey_balls", "matrix_2x2",
                                  "tornado", "pie", "doughnut"]},
                "categories": {"type": "array", "items": {"type": ["string", "number"]}},
                "series": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/series"}},
                "unit": {"type": "string", "description": "e.g. '$M', '%', 'jobs (thousands)'; shown in the exhibit subtitle"},
                "decimals": {"type": "integer", "minimum": 0, "maximum": 3},
                "highlight_categories": {"type": "array", "items": {"type": ["string", "number"]}},
                "x": {"type": "array", "items": {"type": "number"}, "description": "scatter/bubble x values; marimekko widths"},
                "size": {"type": "array", "items": {"type": "number"}, "description": "bubble sizes"},
                "annotations": {"type": "array", "items": {"type": "object", "required": ["category", "text"],
                                "properties": {"category": {}, "series": {"type": "string"}, "text": {"type": "string", "maxLength": 40}}}}
              }},
    "table": {"type": "object", "required": ["columns", "rows"], "additionalProperties": false,
              "properties": {"columns": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
                             "rows": {"type": "array", "maxItems": 14, "items": {"type": "array"}},
                             "prov": {"$ref": "#/$defs/prov"}, "highlight_rows": {"type": "array", "items": {"type": "integer"}},
                             "unit": {"type": "string"}}}
  },
  "properties": {
    "id": {"type": "string"},
    "node": {"type": "string", "description": "the approved storyline node this slide proves (P12)"},
    "section": {"type": "string", "description": "section name; 'Appendix' puts the slide in the appendix section (P16)"},
    "archetype": {"type": "string", "description": "a name from engine-spec.md archetype library (P15)"},
    "title": {"type": "string", "maxLength": 120, "description": "action title: one sentence, a verb, <=15 words (P11)"},
    "title_prov": {"$ref": "#/$defs/prov"},
    "subtitle": {"type": "string", "maxLength": 100, "description": "exhibit subtitle: what is measured, unit, period"},
    "bullets": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/bullet"}},
    "panels": {"type": "array", "maxItems": 4, "description": "columns/cards/quadrants/phases, archetype-dependent",
               "items": {"type": "object", "additionalProperties": false,
                         "properties": {"heading": {"type": "string", "maxLength": 40}, "bullets": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/bullet"}},
                                        "value": {"$ref": "#/$defs/text"}, "icon": {"type": "string"}, "rating": {"type": "number", "minimum": 0, "maximum": 4}}}},
    "chart": {"$ref": "#/$defs/chart"},
    "charts": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/chart"}},
    "table": {"$ref": "#/$defs/table"},
    "takeaway": {"$ref": "#/$defs/text"},
    "source": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string", "maxLength": 200}, "prov": {"$ref": "#/$defs/prov"}}},
    "notes": {"type": "string", "description": "speaker notes; detail cut from the slide goes here"},
    "gaps": {"type": "array", "items": {"type": "string"}, "description": "numbers the model could not source; rendered as visible [GAP] markers (P13)"}
  }
}
