# Meshpool settings. Edit here or in the app (Settings). Lines starting with # are ignored.
# Never share this file: it holds your API key.

# Your Meshpool API key (any OpenAI-compatible key works with a matching endpoint).
MESHPOOL_API_KEY=

# OpenAI-compatible endpoint and model.
MESHPOOL_BASE_URL=https://llm.meshpool.ai/v1
MH_MODEL=deepseek-v4.1-flash

# Coding agent: ask = confirm before file edits and commands, auto = allow them.
MH_AGENT_PERMISSIONS=ask

# Per-task prompt cache key for the one-shot engines (leave as is).
MH_CACHE_KEY=1

# Optional spend cap per one-shot task in US dollars (0 = off).
MH_BUDGET_USD=0

# Tokens for MCP servers in mcp.json go here too, for example:
# GITHUB_TOKEN=
